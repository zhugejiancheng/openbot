# OpenBot Environment Variables

# Application Settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# AI API Settings
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-3.5-turbo
TEMPERATURE=0.7
MAX_TOKENS=1000

# Database Settings (if applicable)
DATABASE_URL=postgresql://username:password@localhost:5432/openbot_db

# Security
JWT_SECRET=your_jwt_secret_here